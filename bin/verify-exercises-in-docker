#!/usr/bin/env bash

# Synopsis:
# Verify that each exercise's example/exemplar solution passes the tests
# using the track's test runner Docker image.

die() { echo "$*" >&2; exit 1; }

required_tool() {
    command -v "${1}" >/dev/null 2>&1 ||
        die "${1} is required but not installed. Please install it and make sure it's in your PATH."
}

required_tool docker
required_tool jq
required_tool git

self=$(readlink -e "$0")
bin=${self%/*}
REPO_ROOT=$(git -C "${bin}" rev-parse --show-toplevel)
track=$(jq -r .slug "${REPO_ROOT}/config.json")

pull_docker_image() {
    docker image inspect "${image}" >/dev/null 2>&1 || docker pull "${image}" ||
        die $'Could not find the `'"${image}"$'` Docker image.\nCheck the test runner docs at https://exercism.org/docs/building/tooling/test-runners for more information.'
}

verify_exercises() {
    docker run \
        --rm \
        --network none \
        --env RUNALL=true \
        --mount type=bind,src="${REPO_ROOT}",dst=/swift \
        --mount type=volume,dst=/tmp \
        --workdir /swift \
        --entrypoint swift \
        "${image}" test --build-system native
}

image=""
while getopts :i: opt; do
    case $opt in
        i) image=$OPTARG ;;
        ?) echo >&2 "Unknown option: -$OPTARG"; exit 1 ;;
    esac
done
shift "$((OPTIND - 1))"

if [[ -z "${image}" ]]; then
    image="exercism/${track}-test-runner"
    pull_docker_image
fi

verify_exercises
